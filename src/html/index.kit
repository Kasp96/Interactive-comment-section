<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frontend Mentor | Interactive comments section</title>
    <!-- @include 'styles.kit' -->
</head>

<body>

    <div class="app">
        <div class="container-xl">
            <div class="comments-section mx-2">
                <div class="comment-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <img class="user-avatar" src="../images/image-amyrobson.png" alt="user image">
                        <h2 class="comment-author">amyrobson</h2>
                        <h3 class="posting-date">1 month ago</h3>
                    </div>
                    <p class="comment-text my-3">Impressive! Though it seems the drag feature could be improved. But overall
                        it looks incredible. You've nailed the design and the responsiveness at various breakpoints
                        works really well.</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <button class="voting-btn justify-content-center d-flex align-items-center">
                            <img src="../images/icon-plus.svg" alt="">
                            <span class="voting-counter">12</span>
                            <img src="../images/icon-minus.svg" alt="">
                        </button>
                        <button class="reply-btn d-flex align-items-center gap-2">
                            <img src="../images/icon-reply.svg" alt="">
                            Reply
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>







    <!-- @include 'scripts.kit' -->
</body>

</html>